@page
@model RegisterMultipleModel
@using Microsoft.AspNetCore.Mvc.Rendering
@using TestShared
@inject Microsoft.Extensions.Localization.IStringLocalizer<TestFrontend.WorkerText> Text
@{
    ViewData["Title"] = Text["MultipleRegistration"];
}

<partial name="_WorkerLanguage" />
@if (Model.Completed)
{
    <h1>@Text["RegistrationComplete"]</h1>
    <p role="status">@Text["MultipleRegistered", Model.RegisteredCount]</p>
}
else
{
    <h1>@Text["MultipleRegistration"]</h1>
    @if (!Model.IsValid)
    {
        <div class="alert alert-danger" role="alert">@Text[Model.StatusMessage ?? "InvalidLink"]</div>
    }
    else
    {
        @if (Model.StatusMessage is not null)
        {
            <div class="alert alert-warning" role="alert">@Text[Model.StatusMessage]</div>
        }
          <form method="post" asp-route-token="@Model.Token" asp-route-lang="@Request.Query["lang"]" class="col-lg-8" data-multiple-registration
              data-maximum-staff="@LinkMultipleRegistrationRequest.MaximumStaff" data-entry-label="@Text["StaffEntry", "{0}"]" data-remove-label="@Text["RemoveStaff", "{0}"]">
            <div asp-validation-summary="All" class="text-danger" role="alert"></div>
            @for (var index = 0; index < Model.Staff.Count; index++)
            {
                <fieldset class="border-top pt-3 mb-4" data-staff-entry>
                    <legend class="h5">@Text["StaffEntry", index + 1]</legend>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Staff[index].FirstName" class="form-label">@Text["FirstName"]</label>
                            <input asp-for="Staff[index].FirstName" class="form-control" />
                            <span asp-validation-for="Staff[index].FirstName" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Staff[index].LastName" class="form-label">@Text["LastName"]</label>
                            <input asp-for="Staff[index].LastName" class="form-control" />
                            <span asp-validation-for="Staff[index].LastName" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Staff[index].Email" class="form-label">@Text["Email"]</label>
                            <input asp-for="Staff[index].Email" class="form-control" />
                            <span asp-validation-for="Staff[index].Email" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Staff[index].PhoneNumber" class="form-label">@Text["Phone"]</label>
                            <input asp-for="Staff[index].PhoneNumber" class="form-control" />
                            <span asp-validation-for="Staff[index].PhoneNumber" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Staff[index].StaffRoleId" class="form-label">@Text["Role"]</label>
                            <select asp-for="Staff[index].StaffRoleId" class="form-select" data-role-select asp-items="@(new SelectList(Model.StaffRoles, "Id", "Name"))">
                                <option value="">@Text["SelectRole"]</option>
                            </select>
                            <span asp-validation-for="Staff[index].StaffRoleId" class="text-danger"></span>
                            @foreach (var role in Model.StaffRoles)
                            {
                                if (Model.RoleRequiredDocuments.TryGetValue(role.Id, out var documents) && documents.Count > 0)
                                {
                                    <div class="form-text" data-role-id="@role.Id" hidden="@(Model.Staff[index].StaffRoleId != role.Id)">
                                        @Text["RequiredDocuments"]: <strong>@string.Join(", ", documents)</strong>
                                    </div>
                                }
                            }
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Staff[index].StaffTypeId" class="form-label">@Text["StaffType"]</label>
                            <select asp-for="Staff[index].StaffTypeId" class="form-select" asp-items="@(new SelectList(Model.StaffTypes, "Id", "Name"))">
                                <option value="">@Text["SelectType"]</option>
                            </select>
                            <span asp-validation-for="Staff[index].StaffTypeId" class="text-danger"></span>
                        </div>
                    </div>
                    <button type="submit" asp-page-handler="Remove" asp-route-index="@index" asp-route-token="@Model.Token" asp-route-lang="@Request.Query["lang"]" class="btn btn-sm btn-outline-danger mt-3" formnovalidate data-remove-staff hidden="@(Model.Staff.Count <= 1)">@Text["RemoveStaff", index + 1]</button>
                </fieldset>
            }
            <div class="d-flex gap-2 flex-wrap">
                <button type="submit" asp-page-handler="Add" asp-route-token="@Model.Token" asp-route-lang="@Request.Query["lang"]" class="btn btn-outline-secondary" disabled="@(Model.Staff.Count >= LinkMultipleRegistrationRequest.MaximumStaff)" formnovalidate data-add-staff>@Text["AddAnother"]</button>
                <button type="submit" class="btn btn-primary">@Text["RegisterAll"]</button>
            </div>
        </form>
    }
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}