@page
@model TestFrontend.Pages.UsersModel
@{ ViewData["Title"] = "Accounts"; }
<h1 id="users-heading">Accounts</h1>
<div class="table-scroll" role="region" aria-labelledby="users-heading" tabindex="0">
<table class="table"><thead><tr><th scope="col">Email</th><th scope="col">Role</th><th scope="col">Enabled</th><th scope="col">MFA</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr></thead><tbody>
@foreach (var user in Model.Data.Users)
{
    <tr><td class="cell-text">@user.Email</td><td>@user.Role</td><td>@user.IsEnabled</td><td>@user.MfaEnabled</td><td><a class="touch-link" asp-route-id="@user.Id" data-user="@System.Text.Json.JsonSerializer.Serialize(new { user.Id, user.Email, user.RoleId, user.IsEnabled, user.MfaEnabled })">Edit</a></td></tr>
}
</tbody></table></div>
<h2 data-user-heading>@(Model.Id is null ? "Add user" : "Edit user")</h2>
<form method="post" class="row g-3" data-user-editor>
    <div asp-validation-summary="All" class="text-danger"></div>
    <input type="hidden" asp-for="Id" />
    <div class="col-md-6"><label asp-for="Input.Email" class="form-label">Email</label><input asp-for="Input.Email" class="form-control" required /></div>
    <div class="col-md-6"><label asp-for="Input.Password" class="form-label">New password</label><input asp-for="Input.Password" type="password" autocomplete="new-password" class="form-control" minlength="12" /></div>
    <div class="col-md-6"><label asp-for="Input.RoleId" class="form-label">Role</label><select asp-for="Input.RoleId" class="form-select">
    @foreach (var role in Model.Data.Roles.Where(role => role.Name != "Admin" || User.IsInRole("Admin")))
    { <option value="@role.Id">@role.Name</option> }
    </select></div>
    <div class="col-md-6">
        <div class="form-check"><input asp-for="Input.IsEnabled" class="form-check-input" /><label asp-for="Input.IsEnabled" class="form-check-label">Enabled</label></div>
        <div class="form-check"><input asp-for="Input.MfaEnabled" class="form-check-input" /><label asp-for="Input.MfaEnabled" class="form-check-label">Email MFA</label></div>
    </div>
    <div><button class="btn btn-primary" type="submit">Save</button> <a asp-page="/Users" asp-route-id="" class="btn btn-secondary" data-user="{}">New user</a></div>
</form>