@page
@model TestFrontend.Pages.ManageTermsModel
@{
    ViewData["Title"] = "Manage Terms";
    string LanguageName(string language) => language switch { "en" => "English", "pl" => "Polish", "uk" => "Ukrainian", _ => language };
}

<h1>Manage Terms</h1>
@if (Model.StatusMessage is not null)
{
    <div class="alert alert-success" role="status">@Model.StatusMessage</div>
}

@if (!Model.IsEditing)
{
    @if (Model.Terms.Count == 0)
    {
        <p class="text-muted">No terms documents found.</p>
    }
    else
    {
        <div class="row g-3 mb-4">
            <form method="get" class="col-md-6">
                <label asp-for="DocumentId" class="form-label">Terms document</label>
                <div class="d-flex gap-2">
                    <select asp-for="DocumentId" class="form-select" onchange="this.form.requestSubmit()">
                        @foreach (var terms in Model.Terms)
                        { <option value="@terms.Id">@terms.Title</option> }
                    </select>
                    <noscript><button type="submit" class="btn btn-outline-primary">Open</button></noscript>
                </div>
            </form>
            @if (Model.Versions.Count > 0)
            {
                <form method="get" class="col-md-6">
                    <input type="hidden" name="DocumentId" value="@Model.DocumentId" />
                    <label asp-for="VersionId" class="form-label">Version and language</label>
                    <div class="d-flex gap-2">
                        <select asp-for="VersionId" class="form-select" onchange="this.form.requestSubmit()">
                            @foreach (var version in Model.Versions)
                            {
                                <option value="@version.Id">Version @version.Version - @LanguageName(version.Language) (@(version.IsActive ? "Current" : "Previous"))</option>
                            }
                        </select>
                        <noscript><button type="submit" class="btn btn-outline-primary">View</button></noscript>
                    </div>
                </form>
            }
        </div>
    }

    <div class="d-flex gap-2 flex-wrap mb-4">
        @if (Model.SelectedDocument is not null)
        {
            <a asp-page="/ManageTerms" asp-route-documentId="@Model.DocumentId" asp-route-mode="version" class="btn btn-primary">Add a new version</a>
        }
        <a asp-page="/ManageTerms" asp-route-mode="document" class="btn btn-outline-secondary">Add terms document</a>
    </div>

    @if (Model.SelectedVersion is { } selected)
    {
        <section class="border-top pt-3" aria-labelledby="terms-heading">
            <h2 id="terms-heading" class="h4 text-break">@selected.TermsDocument.Title</h2>
            <div class="d-flex flex-wrap gap-2 text-muted mb-3">
                <span>Version @selected.Version</span><span>@LanguageName(selected.Language)</span>
                <span>@(selected.IsActive ? "Current" : "Previous")</span>
                <span>Published @selected.CreatedAt.ToLocalTime().ToString("g")</span>
            </div>
            <div class="text-break" lang="@selected.Language" style="white-space: pre-wrap">@selected.Content</div>
        </section>
    }
    else if (Model.SelectedDocument is not null)
    {
        <p class="text-muted">No published versions for this document.</p>
    }
}
else
{
    <h2 class="h4">@(Model.Mode == "document" ? "Add terms document" : "Add a new version")</h2>
    <form method="post" class="row g-3" asp-route-mode="@Model.Mode" asp-route-documentId="@Model.DocumentId">
        <div asp-validation-summary="All" class="text-danger" role="alert"></div>
        <div class="col-12">
            <label asp-for="Input.Title" class="form-label">Title</label>
            <input asp-for="Input.Title" class="form-control" maxlength="256" readonly="@(Model.Mode == "version")" />
            <span asp-validation-for="Input.Title" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label asp-for="Input.English" class="form-label">English</label>
            <textarea asp-for="Input.English" class="form-control" rows="8" maxlength="100000" lang="en"></textarea>
            <span asp-validation-for="Input.English" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label asp-for="Input.Polish" class="form-label">Polish</label>
            <textarea asp-for="Input.Polish" class="form-control" rows="8" maxlength="100000" lang="pl"></textarea>
            <span asp-validation-for="Input.Polish" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label asp-for="Input.Ukrainian" class="form-label">Ukrainian</label>
            <textarea asp-for="Input.Ukrainian" class="form-control" rows="8" maxlength="100000" lang="uk"></textarea>
            <span asp-validation-for="Input.Ukrainian" class="text-danger"></span>
        </div>
        <div class="col-12 d-flex gap-2 flex-wrap">
            <button class="btn btn-primary" type="submit">Publish new version and require reacceptance</button>
            <a asp-page="/ManageTerms" asp-route-documentId="@Model.DocumentId" asp-route-versionId="@Model.VersionId" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}