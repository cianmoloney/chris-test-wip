@page
@model FilesModel
@{
    ViewData["Title"] = "File Explorer";
}

<h1>File Explorer</h1>

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a asp-page="/Files">Root</a>
        </li>
        @{
            var crumbPath = "";
        }
        @foreach (var segment in Model.PathSegments)
        {
            crumbPath += segment + "/";
            if (crumbPath == Model.Prefix)
            {
                <li class="breadcrumb-item active" aria-current="page">@segment</li>
            }
            else
            {
                <li class="breadcrumb-item">
                    <a asp-page="/Files" asp-route-prefix="@crumbPath">@segment</a>
                </li>
            }
        }
    </ol>
</nav>

@if (Model.StatusMessage is not null)
{
    <div class="alert alert-warning">@Model.StatusMessage</div>
}

@if (User.HasClaim("permission", TestShared.Permissions.DocumentsWrite))
{
<form method="post" enctype="multipart/form-data"
    asp-page="/Files" asp-page-handler="Upload" asp-route-prefix="@Model.Prefix">
    <input type="file" name="upload" class="form-control w-auto" />
    <button type="submit" class="btn btn-primary">Upload</button>
</form>
}

<table class="table table-hover">
    <thead>
        <tr>
            <th>Name</th>
            <th>Size</th>
            <th>Last Modified</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var folder in Model.Folders)
        {
            <tr>
                <td>
                    📁 <a asp-page="/Files" asp-route-prefix="@folder.Prefix">@folder.Name</a>
                </td>
                <td>—</td>
                <td>—</td>
                <td></td>
            </tr>
        }
        @foreach (var file in Model.Files)
        {
            <tr>
                <td>📄 @file.Name</td>
                <td>@file.SizeDisplay</td>
                <td>@file.LastModified?.ToString("g")</td>
                <td>
                    <a class="btn btn-sm btn-outline-primary"
                              asp-page="/Files" asp-page-handler="Download" asp-route-blobName="@file.BlobName">
                        Download
                    </a>
                </td>
            </tr>
        }
        @if (Model.Folders.Count == 0 && Model.Files.Count == 0)
        {
            <tr>
                <td colspan="4" class="text-muted">This folder is empty.</td>
            </tr>
        }
    </tbody>
</table>
