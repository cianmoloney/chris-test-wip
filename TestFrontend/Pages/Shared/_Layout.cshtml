<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TestFrontend</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TestFrontend.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-xl navbar-light bg-white border-bottom box-shadow mb-3" aria-label="Main navigation">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">TestFrontend</a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation" aria-controls="mainNavigation"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div id="mainNavigation" class="navbar-collapse collapse justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                            @if (User.HasClaim("permission", TestShared.Permissions.StaffRead))
                            {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-page="/Staff">Manage Staff</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-page="/Documents">Document Explorer</a>
                            </li>
                            }
                            @if (User.HasClaim("permission", TestShared.Permissions.LinksWrite))
                            {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-page="/GenerateLink">Generate Link</a>
                            </li>
                            }
                            @if (User.HasClaim("permission", TestShared.Permissions.TermsWrite))
                            { <li class="nav-item"><a class="nav-link text-dark" asp-page="/ManageTerms">Manage Terms</a></li> }
                            @if (User.HasClaim("permission", TestShared.Permissions.UsersWrite))
                            { <li class="nav-item"><a class="nav-link text-dark" asp-page="/Users">Accounts</a></li> }
                            @if (User.IsInRole("Admin"))
                            { <li class="nav-item"><a class="nav-link text-dark" asp-page="/Roles">Access Editor</a></li> }
                    </ul>
                    <div class="d-flex align-items-center gap-1 flex-shrink-0">
                        <a class="nav-link text-dark account-link" asp-page="/Account" aria-label="My account" title="My account">
                            <img src="~/lib/lucide/user-round.svg" width="24" height="24" alt="" aria-hidden="true" />
                        </a>
                        <form method="post" asp-page="/Login" asp-page-handler="Logout" class="d-flex m-0">
                            <button type="submit" class="btn btn-link nav-link text-dark">Sign out</button>
                        </form>
                    </div>
                </div>
                }
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - TestFrontend - Built by <a href="mailto:moloneysheehanltd@gmail.com">MSTMC</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>


    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
