@page
@model GenerateLinkModel
@{
    ViewData["Title"] = "Generate Secure Upload Link";
}

<h1>Generate Secure Link</h1>


@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<form method="post" class="mb-3 row g-3 align-items-end">
    <div class="col-md-6">
    <label asp-for="LinkType" class="form-label">Link type</label>
    <select asp-for="LinkType" class="form-select">
        <option value="register">Registration link</option>
        <option value="register-many">Multiple registration link</option>
        <option value="upload">File upload link</option>
        <option value="terms">Terms acceptance link</option>
    </select>
    </div>
    <div class="col-md-6">
    <label asp-for="StaffId" class="form-label">Staff member</label>
    <select asp-for="StaffId" class="form-select" disabled="@(Model.LinkType is TestShared.ShareLinkPurposes.Register or TestShared.ShareLinkPurposes.RegisterMultiple)">
        <option value="">No staff member (generic link)</option>
        @foreach (var staff in Model.StaffList)
        {
            <option value="@staff.Id">@staff.LastName, @staff.FirstName (@staff.Email)</option>
        }
    </select>
    </div>
    <div class="col-md-6">
        <label asp-for="TermsDocumentId" class="form-label">Terms document</label>
        <select asp-for="TermsDocumentId" class="form-select" disabled="@(Model.LinkType != TestShared.ShareLinkPurposes.Terms)">
            <option value="">Select terms</option>
            @foreach (var terms in Model.TermsDocuments) { <option value="@terms.Id">@terms.Title</option> }
        </select>
    </div>
    <div class="col-md-6">
        <label asp-for="ValidHours" class="form-label">Valid for</label>
        <div class="input-group link-duration">
            <input type="number" asp-for="ValidHours" class="form-control" min="1" max="336" aria-describedby="duration-unit" />
            <span class="input-group-text" id="duration-unit">hours</span>
        </div>
    </div>
    <div class="col-12">
    <button type="submit" class="btn btn-primary">Generate secure link</button>
    </div>
</form>

@if (Model.ShareLink is not null)
{
    <div class="alert alert-info">
        <p class="mb-1">
            <strong>Secure link</strong>
            (expires @Model.ShareLinkExpiresAt?.ToLocalTime().ToString("g")):
        </p>
        <input type="text" class="form-control" readonly value="@Model.ShareLink"
               onclick="this.select()" aria-label="Secure link" />
        <form method="post" asp-page-handler="Revoke" class="mt-2">
            <input type="hidden" asp-for="IssuedLinkId" />
            <button type="submit" class="btn btn-sm btn-outline-danger">Revoke link</button>
        </form>
        <small class="text-muted">
            Anyone with this link can use it until it expires.
            Share it only with the intended recipient.
        </small>
    </div>
}

@section Scripts {
    <script>
        const linkType = document.getElementById('LinkType');
        const staffChoice = document.getElementById('StaffId');
        const termsChoice = document.getElementById('TermsDocumentId');
        const updateChoices = () => {
            staffChoice.disabled = linkType.value === 'register' || linkType.value === 'register-many';
            termsChoice.disabled = linkType.value !== 'terms';
            if (staffChoice.disabled) staffChoice.value = '';
            if (termsChoice.disabled) termsChoice.value = '';
        };
        linkType.addEventListener('change', updateChoices);
        updateChoices();
    </script>
}
