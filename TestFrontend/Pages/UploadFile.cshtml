@page
@model UploadFileModel
@{
    ViewData["Title"] = "Upload File";
}

<h1>Upload File</h1>

@if (Model.StatusMessage is not null)
{
    <div class="alert alert-success" role="status">@Model.StatusMessage</div>
}

<div class="row upload-file">
    <div class="col-12 col-lg-8 col-xl-6">
        <form method="post" enctype="multipart/form-data" class="mt-3">
            <div asp-validation-summary="All" class="text-danger" role="alert"></div>
            <div class="mb-3">
                <label asp-for="DocumentTypeId" class="form-label">Document type</label>
                <select asp-for="DocumentTypeId" class="form-select" disabled="@(!Model.TypesLoaded)">
                    <option value="">Auto-detect</option>
                    @foreach (var type in Model.DocumentTypes)
                    { <option value="@type.Id">@type.Name</option> }
                </select>
                <span asp-validation-for="DocumentTypeId" class="text-danger"></span>
            </div>
            <div class="mb-4">
                <label asp-for="Upload" class="form-label">File</label>
                <input asp-for="Upload" type="file" class="form-control" accept=".pdf,.jpg,.jpeg,.png,.tif,.tiff,.bmp,.webp" required />
                <span asp-validation-for="Upload" class="text-danger"></span>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-primary d-inline-flex align-items-center gap-2" disabled="@(!Model.TypesLoaded)">
                    <img src="~/lib/lucide/upload.svg" width="20" height="20" alt="" class="upload-icon" />
                    Upload
                </button>
                <a asp-page="/Documents" class="btn btn-outline-secondary">Document Explorer</a>
            </div>
        </form>
    </div>
</div>