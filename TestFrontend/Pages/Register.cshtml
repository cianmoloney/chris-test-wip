@page
@model RegisterModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<TestFrontend.WorkerText> Text
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Staff Registration";
    Layout = "_Layout";
}

<partial name="_WorkerLanguage" />
<h1>@Text["Registration"]</h1>

@if (!Model.IsValid)
{
    <div class="alert alert-danger">
        @Text[Model.StatusMessage is null ? "InvalidLink" : "Failure"]
    </div>
}
else
{
    @if (Model.StatusMessage is not null)
    {
        <div class="alert alert-info">@Text["Failure"]</div>
    }

    <form method="post" asp-route-token="@Model.Token" asp-route-lang="@Request.Query["lang"]" class="col-md-6">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="mb-3">
            <label asp-for="Input.FirstName" class="form-label">@Text["FirstName"]</label>
            <input asp-for="Input.FirstName" class="form-control" />
            <span asp-validation-for="Input.FirstName" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Input.LastName" class="form-label">@Text["LastName"]</label>
            <input asp-for="Input.LastName" class="form-control" />
            <span asp-validation-for="Input.LastName" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Input.Email" class="form-label">@Text["Email"]</label>
            <input asp-for="Input.Email" class="form-control" />
            <span asp-validation-for="Input.Email" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Input.PhoneNumber" class="form-label">@Text["Phone"]</label>
            <input asp-for="Input.PhoneNumber" class="form-control" />
            <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Input.StaffRoleId" class="form-label">@Text["Role"]</label>
            <select asp-for="Input.StaffRoleId" class="form-select" id="role-select"
                    asp-items="@(new SelectList(Model.StaffRoles, "Id", "Name"))">
                <option value="">@Text["SelectRole"]</option>
            </select>
            <span asp-validation-for="Input.StaffRoleId" class="text-danger"></span>
            @foreach (var role in Model.StaffRoles)
            {
                if (Model.RoleRequiredDocuments.TryGetValue(role.Id, out var docs) && docs.Count > 0)
                {
                    <div class="form-text role-docs" data-role-id="@role.Id" style="display:none">
                        @Text["RequiredDocuments"]:
                        <strong>@string.Join(", ", docs)</strong>
                    </div>
                }
            }
        </div>
        <div class="mb-3">
            <label asp-for="Input.StaffTypeId" class="form-label">@Text["StaffType"]</label>
            <select asp-for="Input.StaffTypeId" class="form-select"
                    asp-items="@(new SelectList(Model.StaffTypes, "Id", "Name"))">
                <option value="">@Text["SelectType"]</option>
            </select>
            <span asp-validation-for="Input.StaffTypeId" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary">@Text["Register"]</button>
    </form>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const roleSelect = document.getElementById('role-select');
        if (roleSelect) {
            const update = () => {
                document.querySelectorAll('.role-docs').forEach(el => {
                    el.style.display = el.dataset.roleId === roleSelect.value ? '' : 'none';
                });
            };
            roleSelect.addEventListener('change', update);
            update();
        }
    </script>
}
