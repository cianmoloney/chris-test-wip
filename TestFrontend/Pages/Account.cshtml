@page
@model TestFrontend.Pages.AccountModel
@{ ViewData["Title"] = "Account"; }
<h1>Account</h1>
<p>@User.Identity?.Name</p>
<form method="post">
    <div class="form-check mb-3"><input asp-for="MfaEnabled" class="form-check-input" /><label asp-for="MfaEnabled" class="form-check-label">Email verification at sign-in</label></div>
    <button class="btn btn-primary" type="submit">Save and sign in again</button>
</form>