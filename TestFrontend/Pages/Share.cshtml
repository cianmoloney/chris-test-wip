@page
@model ShareModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<TestFrontend.WorkerText> Text
@{
    ViewData["Title"] = "Upload files";
    Layout = "_Layout";
}

<partial name="_WorkerLanguage" />
<h1>@Text["UploadTitle"]</h1>

@if (!Model.IsValid)
{
    <div class="alert alert-danger">
        @Text[Model.StatusMessage is null ? "InvalidLink" : "Failure"]
    </div>
}
else
{
    @if (Model.StatusMessage is not null)
    {
        <div class="alert alert-info">@Text["Failure"]</div>
    }

    <form method="post" enctype="multipart/form-data" class="responsive-toolbar mb-3 d-flex gap-2 flex-wrap"
          asp-page="/Share" asp-page-handler="Upload" asp-route-token="@Model.Token" asp-route-lang="@Request.Query["lang"]">
        <select asp-for="DocumentTypeId" class="form-select w-auto" aria-label="Document type">
            <option value="">@Text["DocumentType"]</option>
            @foreach (var type in Model.DocumentTypes) { <option value="@type.Id">@type.Name</option> }
        </select>
        <input type="file" name="upload" class="form-control w-auto" aria-label="@Text["UploadTitle"]" accept=".pdf,.jpg,.jpeg,.png,.tif,.tiff,.bmp,.webp" required />
        <button type="submit" class="btn btn-primary">@Text["Upload"]</button>
    </form>
}
