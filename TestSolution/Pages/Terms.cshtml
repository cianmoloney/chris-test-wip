@page
@model TermsModel
@{
    ViewData["Title"] = "Terms & Conditions";
    Layout = "_Layout";
}

<h1>Terms &amp; Conditions</h1>

@if (!Model.IsValid)
{
    <div class="alert alert-danger">
        This link is invalid or has expired. Please request a new link.
    </div>
}
else if (Model.Staff is null)
{
    <div class="alert alert-warning">Staff record not found. Please register first.</div>
}
else
{
    @if (Model.StatusMessage is not null)
    {
        <div class="alert alert-info">@Model.StatusMessage</div>
    }

    <div class="mb-3">
        <a asp-page="/Terms" asp-route-token="@Model.Token" asp-route-lang="en" class="btn btn-sm btn-outline-secondary">English</a>
        <a asp-page="/Terms" asp-route-token="@Model.Token" asp-route-lang="pl" class="btn btn-sm btn-outline-secondary">Polski</a>
        <a asp-page="/Terms" asp-route-token="@Model.Token" asp-route-lang="uk" class="btn btn-sm btn-outline-secondary">Українська</a>
    </div>

    @if (Model.AlreadyAccepted)
    {
        <div class="alert alert-success">
            You agreed to these terms on @Model.AcceptedAt?.ToLocalTime().ToString("g").
        </div>
    }
    else if (Model.Terms is null)
    {
        <div class="alert alert-warning">No terms are currently available. Please contact the administrator.</div>
    }
    else
    {
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">@Model.Terms.TermsDocument.Title (v@(Model.Terms.Version))</h5>
                <p class="card-text" style="white-space: pre-wrap;">@Model.Terms.Content</p>
            </div>
        </div>

        <form method="post" asp-route-token="@Model.Token" asp-route-lang="@Model.Lang">
            <div class="form-check mb-3">
                <input asp-for="Agree" class="form-check-input" />
                <label asp-for="Agree" class="form-check-label">I have read and agree to the terms above</label>
            </div>
            <button type="submit" class="btn btn-primary">Agree</button>
        </form>
    }
}
