@page
@model GenerateLinkModel
@{
    ViewData["Title"] = "Generate Secure Upload Link";
}

<h1>Generate Secure Link</h1>

<p class="text-muted">
    Create a time-limited link for a staff member. Registration links can be anonymous;
    upload and terms links must be issued for a specific staff member so that the
    upload or agreement is associated with their account.
</p>

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<form method="post" class="mb-3 d-flex gap-2 align-items-center flex-wrap">
    <select asp-for="LinkType" class="form-select w-auto">
        <option value="register">Registration link</option>
        <option value="upload">File upload link</option>
        <option value="terms">Terms acceptance link</option>
    </select>
    <select asp-for="StaffId" class="form-select w-auto">
        <option value="">— Select staff member (upload/terms) —</option>
        @foreach (var staff in Model.StaffList)
        {
            <option value="@staff.Id">@staff.LastName, @staff.FirstName (@staff.Email)</option>
        }
    </select>
    <div class="input-group w-auto">
        <input type="number" asp-for="ValidHours" class="form-control" min="1" max="336" style="max-width: 6rem" />
        <span class="input-group-text">hours</span>
    </div>
    <button type="submit" class="btn btn-primary">Generate secure link</button>
</form>

@if (Model.ShareLink is not null)
{
    <div class="alert alert-info">
        <p class="mb-1">
            <strong>Secure link</strong>
            (expires @Model.ShareLinkExpiresAt?.ToLocalTime().ToString("g")):
        </p>
        <input type="text" class="form-control" readonly value="@Model.ShareLink"
               onclick="this.select()" aria-label="Secure link" />
        <small class="text-muted">
            Anyone with this link can use it until it expires.
            Share it only with the intended recipient.
        </small>
    </div>
}
